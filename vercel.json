{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": ["bom1"],
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm build && pnpm db:seed",
  "crons": [
    { "path": "/api/cron/notifications", "schedule": "0 3 * * *" },
    { "path": "/api/cron/abandoned-cart", "schedule": "0 4 * * *" },
    { "path": "/api/cron/release-stock", "schedule": "0 5 * * *" }
  ]
}
