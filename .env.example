# Copy to .env.local for development. Real values live only in Vercel
# (Settings → Environment Variables) and your git-ignored .env.local.
# Every integration falls back to a mock when its keys are missing.

# ── Database (Neon Postgres via Vercel Marketplace) ─────────────────────
DATABASE_URL=            # pooled connection string (runtime)
DIRECT_URL=              # direct/non-pooled connection (migrations)

# ── Auth.js ─────────────────────────────────────────────────────────────
AUTH_SECRET=             # `openssl rand -base64 32`
AUTH_URL=                # e.g. https://yourstore.in (optional on Vercel)
AUTH_GOOGLE_ID=          # Google sign-in (optional)
AUTH_GOOGLE_SECRET=

# ── MSG91: OTP and order SMS (DLT-registered templates) ─────────────────
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=   # template variable: ##otp##
MSG91_SENDER_ID=
# Optional per-event SMS templates (variables: order, link)
MSG91_TEMPLATE_CONFIRMED=
MSG91_TEMPLATE_SHIPPED=
MSG91_TEMPLATE_OUT_FOR_DELIVERY=
MSG91_TEMPLATE_DELIVERED=

# ── Razorpay (test keys on Preview/Development, live on Production) ─────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET= # webhook → https://<domain>/api/webhooks/razorpay
NEXT_PUBLIC_RAZORPAY_KEY_ID=  # publishable key (same as RAZORPAY_KEY_ID)

# ── Shiprocket ──────────────────────────────────────────────────────────
SHIPROCKET_EMAIL=        # API user
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=   # pickup location nickname in Shiprocket
SHIPROCKET_PICKUP_PINCODE=    # pickup pincode for serviceability checks
SHIPROCKET_WEBHOOK_TOKEN=     # sent as x-api-key → https://<domain>/api/webhooks/shiprocket

# ── Email (Resend) ──────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=              # e.g. "[BRAND] <orders@yourstore.in>" (verified domain)

# ── WhatsApp Business API (via MSG91) ───────────────────────────────────
WHATSAPP_API_KEY=
WHATSAPP_SENDER=         # integrated WhatsApp number

# ── Vercel Blob (product images, uploads) ───────────────────────────────
BLOB_READ_WRITE_TOKEN=

# ── Upstash Redis (rate limiting + caches; DB fallback if unset) ────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Sentry ──────────────────────────────────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# ── Analytics (loaded only after cookie consent) ────────────────────────
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# ── Site ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=    # canonical URLs and sitemap, e.g. https://yourstore.in
CRON_SECRET=             # Vercel Cron sends "Authorization: Bearer <CRON_SECRET>"
SEED_ADMIN_PHONE=        # 10-digit mobile that becomes the first ADMIN on seed
APP_ENV=                 # set to "production" only when hosting outside Vercel
